{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Dreamina Scheduler",
  "version": "0.1.0",
  "identifier": "com.guuguo.dreamina-scheduler",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:4186",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "security": {
      "csp": {
        "default-src": ["'self'", "ipc:", "http://ipc.localhost"],
        "connect-src": ["ipc:", "http://ipc.localhost"],
        "img-src": ["'self'", "asset:", "http://asset.localhost", "https://asset.localhost", "data:"],
        "style-src": ["'self'", "'unsafe-inline'"]
      },
      "assetProtocol": {
        "enable": true,
        "scope": [
          "$HOME/.dreamina-scheduler/**",
          "$APPDATA/**",
          "$APPLOCALDATA/**"
        ]
      }
    },
    "windows": [
      {
        "title": "Dreamina Scheduler",
        "width": 1280,
        "height": 820,
        "minWidth": 1060,
        "minHeight": 680,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true,
        "trafficLightPosition": {
          "x": 18,
          "y": 20
        },
        "acceptFirstMouse": true
      }
    ]
  },
  "bundle": {
    "active": true,
    "targets": "all"
  }
}
